<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the hardened runtime; without these the packaged app
         cannot capture audio or spawn the native helpers. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- V8 must reserve executable memory for its CodeRange. Without allow-jit
         the packaged app dies at launch with "Failed to reserve virtual memory
         for CodeRange" — hardened runtime blocks it by default. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The helpers are signed with the same identity but spawned as children. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
