# Copy to .env and fill in. .env is gitignored; this file is safe to commit.
#
# The API is spawned by Electron as a child process, so shell exports do not
# reach it. Values here are loaded by server/config.py at import time.

# Atlassian account email (the one you sign in to Jira with).
ATLASSIAN_EMAIL=

# API token, not your password. Create one at:
# https://id.atlassian.com/manage-profile/security/api-tokens
# Give it a short expiry and revoke it when you stop using this.
ATLASSIAN_API_TOKEN=

# GitHub token for indexing rtt-org repos.
#
# Optional but recommended: without it, indexing shells out to `gh auth token`,
# which depends on the gh CLI being installed, logged in as the work account,
# and its keychain entry unlocked. Any of those failing shows up as an opaque
# clone error.
#
# Create a fine-grained PAT with read-only "Contents" access to the rtt-org
# repos (classic PAT with 'repo' scope also works).
GITHUB_TOKEN=

# Unlock Jira / Confluence / code sources (⌘⇧1-3).
# Leave unset for general use: transcription, answers from the conversation, and
# screen context only. Either 0 or 1 for false or true.
DEVELOPER_MODE=

# Speech recognition locale. Default en-US.
# If accents are transcribed poorly, try a locale whose acoustic model was
# trained on closer accents: en-GB, en-IN, en-AU, en-IE, en-NZ, en-CA, en-SG.
SPEECH_LOCALE=en-US
