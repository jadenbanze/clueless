# Copy to .env and fill in. .env is gitignored; this file is safe to commit.
#
# Where it lives:
#   - Installed app:  ~/Library/Application Support/Clueless/.env
#   - From source:    the project root
#
# The API is spawned by Electron as a child process, so shell exports do not
# reach it. Values here are loaded by server/config.py at import time.
# Non-secret settings (profile, models, Jira site, ...) are easier to set in
# Settings… and are saved to settings.json instead; only secrets belong here.

# ── Work sources (developer profile only) ───────────────────────────────────

# Atlassian account email (the one you sign in to Jira with).
ATLASSIAN_EMAIL=

# API token, not your password. Create one at:
# https://id.atlassian.com/manage-profile/security/api-tokens
# Give it a short expiry and revoke it when you stop using this.
ATLASSIAN_API_TOKEN=

# GitHub token for indexing the repositories listed in Settings.
#
# Optional: without it, indexing shells out to `gh auth token`, which depends on
# the gh CLI being installed and logged in. Create a fine-grained PAT with
# read-only "Contents" access to just those repositories.
GITHUB_TOKEN=

# ── Escape hatches (leave unset) ─────────────────────────────────────────────

# Allow a model provider that is not on this machine. Off by default because it
# sends meeting text off the device. Cannot be enabled from the UI on purpose.
# ALLOW_REMOTE_PROVIDER=1

# Force a generation backend for both tasks: ollama | openai_compat | foundation
# LLM_BACKEND=
